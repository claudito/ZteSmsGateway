# Copia este archivo como ".env" y completa los valores reales.
# El archivo ".env" (sin ".example") NO se sube a control de versiones.

# Clave que deben enviar los clientes en el header X-API-Key.
SMS_API_KEY=cambia-esto-por-una-clave-secreta

# Password por defecto para TODOS los routers listados en routers.json
# (el que ves en la etiqueta del equipo, o "admin" si no lo cambiaste).
ZTE_ROUTER_PASSWORD=admin

# Password especifico para un router en particular (opcional).
# Sobreescribe ZTE_ROUTER_PASSWORD solo para ese router.
# El nombre de la variable es ZTE_PASSWORD_<ID EN MAYUSCULAS>, usando el
# mismo "id" que le pusiste en routers.json. Ejemplo, para el router con
# id "router2":
# ZTE_PASSWORD_ROUTER2=otra-password
